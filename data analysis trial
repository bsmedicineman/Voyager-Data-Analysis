    def _bandpass_filter(self, data, lowcut=0.0, highcut=20.0, order=4):
        nyq = 0.5 * self.fs
        low = lowcut / nyq
        high = highcut / nyq
        b, a = butter(order, [low, high], btype="band")
        return filtfilt(b, a, data)

