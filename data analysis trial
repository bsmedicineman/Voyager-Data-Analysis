    def detect_spacetime_foam(
        self,
        window_days=7,
        peak_snr=6.0,
        coherence_thresh=0.70,
        scaling_exclude=(0.8, 1.2, 2.8, 3.2),
        max_clock_distance_hz=5e-6,
        max_speed_error_sec=600,   # ±10 min tolerance on the light‑travel lag
        max_freq_drift_hz=None,
    ):
        """
        Runs the full 5‑criterion pipeline described in your request.

        Parameters
        ----------
        window_days : float
            Length of the sliding window used for periodograms (default 7 d).
        peak_snr : float
            Minimum signal‑to‑noise ratio (peak power / median background) for a line.
        coherence_thresh : float
            Minimum magnitude‑squared coherence between MAG & PWS at the line frequency.
        scaling_exclude : tuple
            (p_low, p_high, p3_low, p3_high) – exponent ranges that correspond to
            $1/r$ (Parker) and $1/r^{3}$ (dipole).  Any fitted exponent *inside*
            these intervals causes the candidate to be rejected.
        max_clock_distance_hz : float
            Frequency distance (absolute Hz) from any known clock below which the
            candidate fails the Clock test.
        max_speed_error_sec : float
            Allowed deviation from the exact light‑travel lag (seconds).
        max_freq_drift_hz : float or None
            If supplied, the line frequency must stay within this absolute band
            across the whole window; if ``None`` the tolerance is set to the
            frequency‑bin width of the Welch estimate.
        """
        print("\n[DETECT] Running spacetime‑foam / GW candidate search …")
        if self.data is None:
            raise RuntimeError("No data loaded – call `load_data_chunked` first.")

        # --------------------------------------------------------------
        # 7.1  Prepare instrument‑specific columns
        # --------------------------------------------------------------
        # We need to identify which columns contain magnetic and electric data
        # First, let's print available columns to understand the data structure
        print(f"[INFO] Available columns: {list(self.data.columns)}")
        
        # Try to identify MAG and PWS columns
        mag_col = None
        pws_col = None
        
        # Common MAG column names
        mag_candidates = ["mag", "mag_amplitude", "b_field", "b", "magnetic", "field", "amplitude_filtered"]
        # Common PWS column names  
        pws_candidates = ["pws", "pws_amplitude", "e_field", "electric", "plasma", "density", "amplitude_filtered"]
        
        for col in self.data.columns:
            col_lower = col.lower()
            if mag_col is None:
                for mag_cand in mag_candidates:
                    if mag_cand in col_lower:
                        mag_col = col
                        break
            if pws_col is None:
                for pws_cand in pws_candidates:
                    if pws_cand in col_lower:
                        pws_col = col
                        break
        
        if mag_col is None:
            print("[WARN] Could not identify MAG column - using amplitude_filtered")
            mag_col = "amplitude_filtered"
        if pws_col is None:
            print("[WARN] Could not identify PWS column - using amplitude_filtered")
            pws_col = "amplitude_filtered"
            
        print(f"[INFO] Using '{mag_col}' as MAG column")
        print(f"[INFO] Using '{pws_col}' as PWS column")

        # --------------------------------------------------------------
        # 7.2  Sliding‑window periodograms (Welch) for both instruments
        # --------------------------------------------------------------
        win_samples = int(window_days * 24 * 3600 * self.fs)   # samples per window
        step_samples = win_samples // 2                      # 50 % overlap

        mag_series = self.data[mag_col].astype(float).values
        pws_series = self.data[pws_col].astype(float).values
        times = self.data["timestamp"].values.astype("datetime64[ns]")

        n_samples = len(mag_series)
        
        # Adjust window size if we don't have enough data
        if n_samples < win_samples:
            print(f"[WARN] Not enough data for {window_days}-day window. Adjusting...")
            win_samples = n_samples // 2
            step_samples = win_samples // 2
        
        if win_samples < 100:
            print(f"[ERROR] Too little data ({n_samples} samples). Cannot perform analysis.")
            return
            
        idx_start = 0
        candidate_records = []

        while idx_start + win_samples <= n_samples:
            # ---- extract the window -------------------------------------------------
            mag_win = mag_series[idx_start : idx_start + win_samples]
            pws_win = pws_series[idx_start : idx_start + win_samples]
            t_start = pd.Timestamp(times[idx_start])
            t_end   = pd.Timestamp(times[idx_start + win_samples - 1])

            # ---- Welch PSDs (same parameters for both) -------------------------------
            f_mag, psd_mag = welch(
                mag_win,
                fs=self.fs,
                nperseg=min(win_samples // 4, 256),  # Ensure reasonable segment size
                detrend="constant",
                scaling="density",
            )
            f_pws, psd_pws = welch(
                pws_win,
                fs=self.fs,
                nperseg=min(win_samples // 4, 256),
                detrend="constant",
                scaling="density",
            )

            # ---- magnitude‑squared coherence (MAG ↔ PWS) ----------------------------
            f_coh, coh = coherence(
                mag_win,
                pws_win,
                fs=self.fs,
                nperseg=min(win_samples // 4, 256),
                detrend="constant",
            )

            # --------------------------------------------------------------
            # 7.3  Find *narrow* peaks that satisfy the SNR criterion
            # --------------------------------------------------------------
            # We look for peaks in the MAG PSD; the same frequency must also be
            # present (within one bin) in the PWS PSD.
            median_mag = np.median(psd_mag)
            median_pws = np.median(psd_pws)

            # Find all peaks in the MAG PSD that exceed peak_snr × median background
            peaks, _ = find_peaks(psd_mag, height=peak_snr * median_mag)

            for pk in peaks:
                freq = f_mag[pk]
                # ---- PWS counterpart -------------------------------------------------
                # locate the nearest bin in the PWS spectrum
                pws_idx = np.argmin(np.abs(f_pws - freq))
                if psd_pws[pws_idx] < peak_snr * median_pws:
                    continue  # not a strong enough line in PWS

                # ---- Cross‑layer coherence test ------------------------------------
                coh_idx = np.argmin(np.abs(f_coh - freq))
                if coh[coh_idx] < coherence_thresh:
                    continue

                # ---- Clock test ------------------------------------------------------
                # distance to the nearest known clock (absolute Hz)
                min_clock_dist = min(abs(freq - c) for c in self.clock_catalog_hz.values())
                if min_clock_dist < max_clock_distance_hz:
                    continue

                # ---- Scaling test ----------------------------------------------------
                # Use the *amplitude* of the line (peak height) and the *distance*
                # at the centre of the window to fit a power‑law exponent.
                # We need the spacecraft distance at the centre of the window:
                win_mid_idx = idx_start + win_samples // 2
                if win_mid_idx >= len(self.data):
                    continue
                    
                dist_au = self.data["distance_au"].iloc[win_mid_idx]
                if np.isnan(dist_au):
                    # if distance is missing we cannot apply the scaling test – reject
                    continue

                # Fit A = K * r^{-p} using just this single point and a reference
                # distance (e.g. 1 AU).  Because we have only one point we cannot
                # really *fit* – we instead compare the measured amplitude with the
                # *expected* amplitude for a Parker‑spiral (p≈1) and a dipole
                # (p≈3).  If the amplitude is *within* 20 % of either expectation,
                # we reject the candidate.
                # --------------------------------------------------------------
                # reference amplitude: median of the whole MAG PSD (background)
                # --------------------------------------------------------------
                ref_amp = median_mag
                # expected amplitudes for the two scaling laws:
                amp_r1 = ref_amp / (dist_au ** 1.0)   # p = 1
                amp_r3 = ref_amp / (dist_au ** 3.0)   # p = 3
                measured_amp = psd_mag[pk]

                # relative deviation from each law:
                dev1 = abs(measured_amp - amp_r1) / amp_r1
                dev3 = abs(measured_amp - amp_r3) / amp_r3

                # reject if *either* deviation is < 0.20 (i.e. within 20 % of a known law)
                if dev1 < 0.20 or dev3 < 0.20:
                    continue

                # ---- Propagation‑speed test (requires the *other* Voyager data) ----
                # This script processes a single spacecraft at a time.  The test
                # will be performed later when both spacecraft CSVs are available.
                # For now we store the candidate together with its time stamp.
                candidate_records.append(
                    {
                        "voyager": self.voyager_num,
                        "window_start": t_start,
                        "window_end": t_end,
                        "frequency_hz": float(freq),
                        "mag_peak_psd": float(psd_mag[pk]),
                        "pws_peak_psd": float(psd_pws[pws_idx]),
                        "coherence": float(coh[coh_idx]),
                        "distance_au": float(dist_au),
                        "peak_snr": float(psd_mag[pk] / median_mag),
                    }
                )

            # --------------------------------------------------------------
            #  move the sliding window forward
            # --------------------------------------------------------------
            idx_start += step_samples

        # ------------------------------------------------------------------
        # 7.4  Assemble the candidate DataFrame
        # ------------------------------------------------------------------
        if not candidate_records:
            print("[DETECT] No line passed the first four criteria – nothing to do.")
            return

        candidates = pd.DataFrame(candidate_records)

        # ------------------------------------------------------------------
        # 7.5  Propagation‑speed (light‑travel) test – requires the *other* spacecraft
        # ------------------------------------------------------------------
        # The idea: if we have both Voyager 1 and Voyager 2 CSVs in the same output
        # folder, we can load the opposite‑craft file and look for a matching
