        other_num = 2 if self.voyager_num == 1 else 1
        other_path = self.output_dir / f"voyager_{other_num}_foam_events_020hz.csv"

        if other_path.is_file():
            other_events = pd.read_csv(other_path, parse_dates=["peak_time"])
            # We need the *inter‑spacecraft* distance at the time of the event.
            # For simplicity we use the mean of the two distances (the distance
            # column is already in AU).  In a full implementation you would query
            # SPICE kernels for the instantaneous separation, but that is beyond
            # the scope of this script.
            # --------------------------------------------------------------
            #   Build a lookup dictionary: (frequency → list of (time, distance))
            # --------------------------------------------------------------
            other_lookup = {}
            for _, row in other_events.iterrows():
                f = round(row["mean_frequency_hz"], 6)   # round to µHz for quick lookup
                other_lookup.setdefault(f, []).append(row)

            # --------------------------------------------------------------
            #   Now test each candidate against the other‑craft list
            # --------------------------------------------------------------
            keep = []
            for _, cand in candidates.iterrows():
                f_round = round(cand["frequency_hz"], 6)
                if f_round not in other_lookup:
                    continue  # no matching line on the other craft

                # there may be several occurrences – we keep the one with the
                # smallest absolute time difference
